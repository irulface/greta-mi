APP_ENV=development
# Omit DATABASE_URL for the SQLite development database.
# Production must use PostgreSQL with pgvector.
# DATABASE_URL=postgresql+psycopg://gretami@localhost:5432/gretamidb
# Include a URL-encoded password if your PostgreSQL authentication requires one.
# DATA_DIR=/srv/market-intelligence/data
# REPOSITORY_ROOT=/srv/market-intelligence/repository
# Generate: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# APP_MASTER_KEY=
# BOOTSTRAP_ADMIN_EMAIL=admin@your-company.com
# BOOTSTRAP_ADMIN_PASSWORD=
# MCP_ALLOWED_HOSTS=mcp.your-company.com
# Additional HTTPS JSON market API hosts; EIA uses its fixed public endpoint.
# MARKET_API_ALLOWED_HOSTS=market-data.your-company.com
# External MCP and enterprise review-task receivers, HTTPS/public IPs only.
# ENTERPRISE_ALLOWED_HOSTS=mcp.provider.com,workflow.your-company.com

# Public HTTPS application origin, used in supplier invitation links.
# PUBLIC_APP_URL=https://mi.your-company.com
SMTP_HOST=asia.emailarray.com
SMTP_PORT=465
SMTP_USERNAME=admin@greta.id
SMTP_PASSWORD=
SMTP_FROM=admin@greta.id
SMTP_USE_TLS=false
SMTP_USE_SSL=true
SMTP_TIMEOUT_SECONDS=15
